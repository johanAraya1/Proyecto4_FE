{
  "expo": {
    "name": "CoffeeCenfo App",
    "slug": "react-native-mvc-app",
    "version": "1.0.0",
    "sdkVersion": "49.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "primaryColor": "#6F4E37",
    "splash": {
      "backgroundColor": "#F5F5F5"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "y",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5F5F5"
      },
      "package": "com.coffeecenfo.reactnativemvcapp"
    },
    "web": {
      "bundler": "metro",
      "backgroundColor": "#F5F5F5",
      "themeColor": "#6F4E37"
    },
    "updates": {
      "enabled": false,
      "checkAutomatically": "ON_ERROR_RECOVERY",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "eas": {
        "projectId": "3f9f62fa-e17f-4fa0-8c13-1f8e00021494"
      }
    }
  }
}
